// ---------------------------------------------------------------------------
// Gestion Ecole - schema relationnel multi-tenant.
//
// PORTABILITE : le schema evite volontairement les `enum` et le type `Decimal`
// afin de rester identique entre SQLite (developpement local, aucun serveur a
// installer) et PostgreSQL (production). Les statuts sont des chaines validees
// par les constantes de src/lib/constants.ts et par Zod cote serveur.
//
// MONTANTS : tous les montants sont des entiers exprimes en UNITES MINEURES de
// la devise (ex. XOF -> 1 unite = 1 franc, decimals = 0 ; EUR -> centimes).
// Aucun calcul financier n'utilise de flottant binaire. Voir src/lib/money.ts.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

// PASSAGE EN POSTGRESQL (production) :
//   1. remplacer `provider = "sqlite"` par `provider = "postgresql"` ci-dessous
//      (Prisma interdit env() sur `provider`, c'est donc un changement manuel) ;
//   2. pointer DATABASE_URL sur le serveur PostgreSQL ;
//   3. `npx prisma migrate dev --name init`.
// Aucun autre fichier n'est a modifier : le schema n'utilise ni enum ni Decimal.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// 1. TENANT, ABONNEMENT SAAS
// ===========================================================================

/// Tenant racine : l'organisation d'un proprietaire. Peut contenir plusieurs ecoles.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String   @default("CI")
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED | CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools        School[]
  subscriptions  Subscription[]
  saasInvoices   SaasInvoice[]
  supportTickets SupportTicket[]

  @@index([status])
}

model Plan {
  id            String   @id @default(cuid())
  code          String   @unique // ESSENTIEL | PROFESSIONNEL | PREMIUM
  name          String
  description   String   @default("")
  priceMinor    Int      @default(0)
  currency      String   @default("XOF")
  billingPeriod String   @default("MONTHLY") // MONTHLY | YEARLY
  maxSchools    Int      @default(1)
  maxStudents   Int      @default(200)
  maxStaff      Int      @default(30)
  features      String   @default("[]") // JSON: codes de modules actives
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(cuid())
  organizationId   String
  planId           String
  status           String    @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | SUSPENDED | CANCELLED
  startedAt        DateTime  @default(now())
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  /// La suspension ne supprime JAMAIS les donnees de l'ecole (cahier des charges 16).
  suspendedAt      DateTime?
  notes            String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  invoices     SaasInvoice[]

  @@index([organizationId, status])
}

/// Facture de l'ABONNEMENT SAAS. Strictement distincte des frais scolaires
/// dus par les familles (modeles FeeAssignment / Installment).
model SaasInvoice {
  id             String    @id @default(cuid())
  organizationId String
  subscriptionId String?
  number         String    @unique
  periodStart    DateTime
  periodEnd      DateTime
  amountMinor    Int
  currency       String    @default("XOF")
  status         String    @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | VOID
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

model SupportTicket {
  id             String    @id @default(cuid())
  organizationId String
  schoolId       String?
  openedById     String?
  subject        String
  body           String
  priority       String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status         String    @default("OPEN") // OPEN | PENDING | RESOLVED | CLOSED
  resolution     String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  closedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  openedBy     User?        @relation(fields: [openedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

// ===========================================================================
// 2. ETABLISSEMENTS
// ===========================================================================

model School {
  id             String @id @default(cuid())
  organizationId String
  name           String
  code           String // unique dans l'organisation
  /// PRESCOLAIRE | PRIMAIRE | COLLEGE | LYCEE | UNIVERSITE | FORMATION_PRO
  type           String @default("PRIMAIRE")
  status         String @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED

  logoDocumentId String?
  address        String  @default("")
  city           String  @default("")
  country        String  @default("CI")
  phone          String  @default("")
  email          String  @default("")
  website        String  @default("")

  currency         String @default("XOF")
  currencyDecimals Int    @default(0)
  locale           String @default("fr-CI")
  timezone         String @default("Africa/Abidjan")

  /// Regle de generation du matricule, ex. "{SCHOOL}-{YEAR}-{SEQ:4}"
  matriculePattern String @default("{SCHOOL}-{YEAR}-{SEQ:4}")
  matriculeCounter Int    @default(0)

  /// Codes des modules optionnels actives (JSON array) : BIBLIOTHEQUE, CANTINE...
  enabledModules     String @default("[]")
  /// Reglages pedagogiques (JSON) : note max, arrondi, classement autorise...
  gradingSettings    String @default("{}")
  /// Reglages comptables (JSON) : referentiel SYSCOHADA, definition du CA...
  accountingSettings String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships          Membership[]
  academicYears        AcademicYear[]
  cycles               Cycle[]
  levels               Level[]
  tracks               Track[]
  classRooms           ClassRoom[]
  subjects             Subject[]
  teachingUnits        TeachingUnit[]
  students             Student[]
  guardians            Guardian[]
  staff                Staff[]
  enrollments          Enrollment[]
  gradingPeriods       GradingPeriod[]
  evaluations          Evaluation[]
  grades               Grade[]
  subjectAppreciations SubjectAppreciation[]
  libraryItems         LibraryItem[]
  assignments          Assignment[]
  attendances          Attendance[]
  timetableSlots       TimetableSlot[]
  feeItems             FeeItem[]
  feeAssignments       FeeAssignment[]
  installments         Installment[]
  payments             Payment[]
  paymentProofs        PaymentProof[]
  receipts             Receipt[]
  refunds              Refund[]
  expenses             Expense[]
  expenseCategories    ExpenseCategory[]
  suppliers            Supplier[]
  financialAccounts    FinancialAccount[]
  ledgerAccounts       LedgerAccount[]
  journalEntries       JournalEntry[]
  accountingPeriods    AccountingPeriod[]
  budgets              Budget[]
  documents            Document[]
  notifications        Notification[]
  announcements        Announcement[]
  messageThreads       MessageThread[]
  auditEvents          AuditEvent[]
  importBatches        ImportBatch[]
  supportTickets       SupportTicket[]
  documentRequests     DocumentRequest[]
  appointmentRequests  AppointmentRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

// ===========================================================================
// 3. UTILISATEURS, ROLES, PERMISSIONS
// ===========================================================================

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String  @default("")
  locale       String  @default("fr")
  status       String  @default("ACTIVE") // ACTIVE | DISABLED | PENDING
  /// Super-administrateur de la plateforme SaaS (transverse, hors tenant).
  isSuperAdmin Boolean @default(false)

  mustChangePassword     Boolean   @default(false)
  lastLoginAt            DateTime?
  failedAttempts         Int       @default(0)
  lockedUntil            DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  memberships     Membership[]
  sessions        Session[]
  staffProfile    Staff?
  guardianProfile Guardian?
  studentProfile  Student?

  auditEvents          AuditEvent[]
  uploadedDocuments    Document[]           @relation("DocumentUploader")
  recordedPayments     Payment[]            @relation("PaymentCashier")
  reviewedProofs       PaymentProof[]       @relation("ProofReviewer")
  submittedProofs      PaymentProof[]       @relation("ProofSubmitter")
  notifications        Notification[]
  postedAnnouncements  Announcement[]
  messages             Message[]
  threadParticipants   ThreadParticipant[]
  importBatches        ImportBatch[]
  postedJournalEntries JournalEntry[]       @relation("JournalPostedBy")
  approvedExpenses     Expense[]            @relation("ExpenseApprover")
  supportTickets       SupportTicket[]
  documentRequests     DocumentRequest[]    @relation("DocRequester")
  appointmentRequests  AppointmentRequest[] @relation("AppointmentRequester")

  @@index([status])
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique // SUPER_ADMIN | OWNER | DIRECTOR | ...
  name        String
  description String  @default("")
  /// Role systeme : non supprimable, permissions gerees par le code.
  isSystem    Boolean @default(true)
  rank        Int     @default(100) // plus petit = plus privilegie

  permissions RolePermission[]
  memberships Membership[]
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // ex. "student.create", "payment.validate"
  resource    String
  action      String
  description String @default("")

  roles RolePermission[]

  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Affectation d'un utilisateur a UNE ecole avec UN role.
/// Un meme utilisateur peut avoir plusieurs memberships (multi-etablissements).
model Membership {
  id        String  @id @default(cuid())
  userId    String
  schoolId  String
  roleId    String
  status    String  @default("ACTIVE") // ACTIVE | SUSPENDED
  /// Permissions additionnelles ou retirees (JSON {"grant":[],"revoke":[]})
  overrides String  @default("{}")
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, schoolId, roleId])
  @@index([schoolId, status])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  activeSchoolId String?
  ipAddress      String    @default("")
  userAgent      String    @default("")
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ===========================================================================
// 4. STRUCTURE ACADEMIQUE
// ===========================================================================

model AcademicYear {
  id        String    @id @default(cuid())
  schoolId  String
  name      String // "2025-2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  /// OPEN | CLOSED : une annee cloturee bloque les ecritures et les notes.
  status    String    @default("OPEN")
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classRooms     ClassRoom[]
  enrollments    Enrollment[]
  gradingPeriods GradingPeriod[]
  feeItems       FeeItem[]
  feeAssignments FeeAssignment[]
  evaluations    Evaluation[]
  budgets        Budget[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Cycle {
  id        String @id @default(cuid())
  schoolId  String
  code      String
  name      String
  sortOrder Int    @default(0)

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  levels Level[]

  @@unique([schoolId, code])
}

model Level {
  id        String  @id @default(cuid())
  schoolId  String
  cycleId   String?
  code      String
  name      String
  sortOrder Int     @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycle  Cycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  classRooms    ClassRoom[]
  feeItems      FeeItem[]
  teachingUnits TeachingUnit[]

  @@unique([schoolId, code])
}

/// Filiere / serie (ex. Serie D au lycee, Licence Informatique a l'universite).
model Track {
  id              String @id @default(cuid())
  schoolId        String
  code            String
  name            String
  /// Pour l'universite : nombre de credits requis pour la diplomation.
  requiredCredits Int?
  sortOrder       Int    @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classRooms    ClassRoom[]
  feeItems      FeeItem[]
  teachingUnits TeachingUnit[]

  @@unique([schoolId, code])
}

model ClassRoom {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  levelId        String
  trackId        String?
  name           String
  code           String
  capacity       Int      @default(40)
  roomLabel      String   @default("")
  mainTeacherId  String?
  status         String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level        @relation(fields: [levelId], references: [id])
  track        Track?       @relation(fields: [trackId], references: [id], onDelete: SetNull)
  mainTeacher  Staff?       @relation("ClassMainTeacher", fields: [mainTeacherId], references: [id], onDelete: SetNull)

  enrollments    Enrollment[]
  classSubjects  ClassSubject[]
  evaluations    Evaluation[]
  assignments    Assignment[]
  attendances    Attendance[]
  timetableSlots TimetableSlot[]
  feeItems       FeeItem[]
  announcements  Announcement[]

  @@unique([schoolId, academicYearId, code])
  @@index([schoolId, academicYearId])
}

/// Unite d'enseignement (UE) - universite. Les Subject rattaches jouent le role d'EC.
model TeachingUnit {
  id       String  @id @default(cuid())
  schoolId String
  levelId  String?
  trackId  String?
  code     String
  name     String
  credits  Int     @default(0)
  semester Int     @default(1)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  level  Level? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  track  Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  subjects Subject[]

  @@unique([schoolId, code])
}

model Subject {
  id                 String  @id @default(cuid())
  schoolId           String
  teachingUnitId     String?
  code               String
  name               String
  /// Coefficient par defaut, surchargeable par classe (ClassSubject).
  defaultCoefficient Int     @default(1)
  /// Credits LMD pour l'universite (EC).
  credits            Int     @default(0)
  isActive           Boolean @default(true)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachingUnit TeachingUnit? @relation(fields: [teachingUnitId], references: [id], onDelete: SetNull)

  classSubjects  ClassSubject[]
  evaluations    Evaluation[]
  appreciations  SubjectAppreciation[]
  assignments    Assignment[]
  timetableSlots TimetableSlot[]
  attendances    Attendance[]

  @@unique([schoolId, code])
}

/// Rattachement d'une matiere a une classe, avec coefficient et enseignant.
model ClassSubject {
  id           String  @id @default(cuid())
  classRoomId  String
  subjectId    String
  teacherId    String?
  coefficient  Int     @default(1)
  maxScore     Int     @default(20)
  hoursPerWeek Int     @default(0)

  classRoom ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Staff?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classRoomId, subjectId])
  @@index([teacherId])
}

model GradingPeriod {
  id                 String    @id @default(cuid())
  schoolId           String
  academicYearId     String
  name               String // "Trimestre 1", "Semestre 1"
  kind               String    @default("TRIMESTRE") // TRIMESTRE | SEMESTRE | MODULE
  sortOrder          Int       @default(0)
  startDate          DateTime
  endDate            DateTime
  /// OPEN : saisie possible | LOCKED : resultats publies et verrouilles
  status             String    @default("OPEN")
  resultsPublishedAt DateTime?

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  evaluations          Evaluation[]
  reportCards          ReportCard[]
  subjectAppreciations SubjectAppreciation[]

  @@unique([academicYearId, name])
  @@index([schoolId, status])
}

// ===========================================================================
// 5. ELEVES, PARENTS, PERSONNEL
// ===========================================================================

model Student {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String?   @unique
  matricule String
  firstName String
  lastName  String
  gender    String    @default("UNSPECIFIED") // M | F | UNSPECIFIED
  birthDate DateTime?

  birthPlace      String  @default("")
  nationality     String  @default("CI")
  photoDocumentId String?
  email           String  @default("")
  phone           String  @default("")
  address         String  @default("")
  bloodGroup      String  @default("")
  medicalNotes    String  @default("")

  emergencyContactName  String @default("")
  emergencyContactPhone String @default("")
  previousSchool        String @default("")

  /// ACTIVE | TRANSFERRED | GRADUATED | DROPPED | ARCHIVED
  status       String    @default("ACTIVE")
  statusReason String    @default("")
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  guardians            StudentGuardian[]
  enrollments          Enrollment[]
  grades               Grade[]
  submissions          Submission[]
  attendances          Attendance[]
  feeAssignments       FeeAssignment[]
  payments             Payment[]
  paymentProofs        PaymentProof[]
  refunds              Refund[]
  documents            Document[]
  reportCards          ReportCard[]
  subjectAppreciations SubjectAppreciation[]
  libraryLoans         LibraryLoan[]
  notifications        Notification[]
  documentRequests     DocumentRequest[]
  appointmentRequests  AppointmentRequest[]

  @@unique([schoolId, matricule])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
}

model Guardian {
  id               String   @id @default(cuid())
  schoolId         String
  userId           String?  @unique
  firstName        String
  lastName         String
  email            String   @default("")
  phone            String   @default("")
  phoneAlt         String   @default("")
  address          String   @default("")
  profession       String   @default("")
  idDocumentNumber String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  students StudentGuardian[]

  @@index([schoolId, lastName])
}

model StudentGuardian {
  id             String   @id @default(cuid())
  studentId      String
  guardianId     String
  /// PERE | MERE | TUTEUR | AUTRE
  relation       String   @default("TUTEUR")
  isPrimary      Boolean  @default(false)
  /// Autorisations explicites du parent sur CET eleve.
  canViewGrades  Boolean  @default(true)
  canViewFinance Boolean  @default(true)
  canPickUp      Boolean  @default(true)
  createdAt      DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
}

model Staff {
  id          String    @id @default(cuid())
  schoolId    String
  userId      String?   @unique
  staffNumber String
  firstName   String
  lastName    String
  gender      String    @default("UNSPECIFIED")
  birthDate   DateTime?
  email       String    @default("")
  phone       String    @default("")
  address     String    @default("")

  photoDocumentId String?
  /// ENSEIGNANT | DIRECTION | ADMINISTRATIF | COMPTABLE | CAISSIER | TECHNIQUE
  jobTitle        String    @default("ENSEIGNANT")
  qualification   String    @default("")
  /// CDI | CDD | VACATAIRE | STAGE
  contractType    String    @default("CDI")
  contractStart   DateTime?
  contractEnd     DateTime?
  /// Remuneration indicative, en unites mineures. Aucun calcul de paie legale.
  baseSalaryMinor Int       @default(0)
  hourlyRateMinor Int       @default(0)
  bankDetails     String    @default("")
  status          String    @default("ACTIVE") // ACTIVE | ON_LEAVE | TERMINATED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  classSubjects        ClassSubject[]
  mainOfClasses        ClassRoom[]           @relation("ClassMainTeacher")
  evaluations          Evaluation[]
  assignments          Assignment[]
  timetableSlots       TimetableSlot[]
  attendanceMarks      Attendance[]          @relation("AttendanceRecorder")
  subjectAppreciations SubjectAppreciation[]
  libraryLoans         LibraryLoan[]
  staffAttendances     StaffAttendance[]
  leaves               StaffLeave[]
  documents            Document[]
  appointmentRequests  AppointmentRequest[]

  @@unique([schoolId, staffNumber])
  @@index([schoolId, status])
}

model StaffAttendance {
  id            String   @id @default(cuid())
  staffId       String
  date          DateTime
  /// PRESENT | ABSENT | RETARD | CONGE
  status        String   @default("PRESENT")
  minutesLate   Int      @default(0)
  minutesWorked Int      @default(0)
  note          String   @default("")
  createdAt     DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}

model StaffLeave {
  id        String   @id @default(cuid())
  staffId   String
  kind      String   @default("CONGE") // CONGE | MALADIE | MATERNITE | AUTRE
  startDate DateTime
  endDate   DateTime
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reason    String   @default("")
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
}

/// Inscription / reinscription d'un eleve dans une classe pour une annee.
model Enrollment {
  id             String @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  classRoomId    String
  /// INSCRIPTION | REINSCRIPTION | TRANSFERT_ENTRANT
  kind           String @default("INSCRIPTION")
  /// ACTIVE | TRANSFERRED_OUT | WITHDRAWN | COMPLETED
  status         String @default("ACTIVE")

  enrolledAt   DateTime  @default(now())
  endedAt      DateTime?
  endReason    String    @default("")
  /// Decision de fin d'annee : ADMIS | REDOUBLE | EXCLU | ORIENTE | EN_ATTENTE
  decision     String    @default("EN_ATTENTE")
  decisionNote String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classRoom    ClassRoom    @relation(fields: [classRoomId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, status])
  @@index([classRoomId, status])
}

// ===========================================================================
// 6. PEDAGOGIE : EVALUATIONS, NOTES, DEVOIRS, ABSENCES, EMPLOI DU TEMPS
// ===========================================================================

model Evaluation {
  id              String  @id @default(cuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  classRoomId     String
  subjectId       String
  teacherId       String?
  title           String
  /// DEVOIR | INTERROGATION | EXAMEN | TP | ORAL | PROJET
  kind            String  @default("DEVOIR")

  date        DateTime
  maxScore    Int       @default(20)
  coefficient Int       @default(1)
  /// DRAFT | SUBMITTED | VALIDATED | PUBLISHED
  status      String    @default("DRAFT")
  /// Session universitaire : NORMALE | RATTRAPAGE
  examSession String    @default("NORMALE")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradingPeriod GradingPeriod @relation(fields: [gradingPeriodId], references: [id], onDelete: Cascade)
  classRoom     ClassRoom     @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  subject       Subject       @relation(fields: [subjectId], references: [id])
  teacher       Staff?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  grades Grade[]

  @@index([schoolId, gradingPeriodId])
  @@index([classRoomId, subjectId])
}

model Grade {
  id           String   @id @default(cuid())
  schoolId     String
  evaluationId String
  studentId    String
  /// Note en CENTIEMES de point (ex. 15,25/20 -> 1525). Entier : pas de flottant.
  scoreCenti   Int?
  /// Absence a l'evaluation : note exclue ou comptee 0 selon le reglage.
  isAbsent     Boolean  @default(false)
  isExcused    Boolean  @default(false)
  comment      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  revisions GradeRevision[]

  @@unique([evaluationId, studentId])
  @@index([schoolId, studentId])
}

/// Journal des corrections de notes (exigence : tracabilite apres publication).
model GradeRevision {
  id                 String   @id @default(cuid())
  gradeId            String
  previousScoreCenti Int?
  newScoreCenti      Int?
  previousIsAbsent   Boolean  @default(false)
  newIsAbsent        Boolean  @default(false)
  reason             String
  changedById        String
  createdAt          DateTime @default(now())

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@index([gradeId])
}

/// Bulletin genere et fige pour un eleve sur une periode.
model ReportCard {
  id                String   @id @default(cuid())
  studentId         String
  gradingPeriodId   String
  /// Moyenne generale en centiemes.
  averageCenti      Int
  rank              Int?
  classSize         Int?
  classAverageCenti Int?
  decision          String   @default("")
  appreciation      String   @default("")
  /// Detail fige (JSON) des moyennes par matiere au moment de la generation.
  detail            String   @default("[]")
  documentId        String?
  publishedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradingPeriod GradingPeriod @relation(fields: [gradingPeriodId], references: [id], onDelete: Cascade)

  @@unique([studentId, gradingPeriodId])
}

model Assignment {
  id                  String    @id @default(cuid())
  schoolId            String
  classRoomId         String
  subjectId           String
  teacherId           String?
  title               String
  description         String    @default("")
  dueAt               DateTime
  maxScore            Int       @default(20)
  /// DRAFT | PUBLISHED | CLOSED
  status              String    @default("DRAFT")
  /// Corrige publie ulterieurement.
  solutionDocumentId  String?
  solutionPublishedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacher   Staff?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  attachments Document[]
  submissions Submission[]

  @@index([schoolId, classRoomId, status])
}

model Submission {
  id           String @id @default(cuid())
  assignmentId String
  studentId    String
  /// A_FAIRE | REMIS | EN_RETARD | CORRIGE
  status       String @default("A_FAIRE")

  submittedAt DateTime?
  content     String    @default("")
  scoreCenti  Int?
  feedback    String    @default("")
  gradedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  attachments Document[]

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
}

model Attendance {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  classRoomId   String
  subjectId     String?
  date          DateTime
  /// PRESENT | ABSENT | RETARD | EXCUSE | RENVOYE
  status        String   @default("PRESENT")
  minutesLate   Int      @default(0)
  justified     Boolean  @default(false)
  justification String   @default("")
  recordedById  String?
  createdAt     DateTime @default(now())

  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom  ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  subject    Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  recordedBy Staff?    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date, subjectId])
  @@index([schoolId, date])
  @@index([classRoomId, date])
}

model TimetableSlot {
  id          String  @id @default(cuid())
  schoolId    String
  classRoomId String
  subjectId   String
  teacherId   String?
  /// 1 = lundi ... 7 = dimanche
  weekday     Int
  startMinute Int // minutes depuis minuit
  endMinute   Int
  room        String  @default("")

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Staff?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([schoolId, classRoomId, weekday])
  @@index([teacherId, weekday])
}

// ===========================================================================
// 7. FRAIS SCOLAIRES, ECHEANCIERS
// ===========================================================================

/// Catalogue de frais parametrable par annee / niveau / classe / filiere.
model FeeItem {
  id             String @id @default(cuid())
  schoolId       String
  academicYearId String
  code           String
  name           String
  /// INSCRIPTION | SCOLARITE | EXAMEN | CANTINE | TRANSPORT | TENUE |
  /// BIBLIOTHEQUE | LOGEMENT | AUTRE
  category       String @default("SCOLARITE")
  amountMinor    Int
  currency       String @default("XOF")

  /// Portee : plus le ciblage est precis, plus il est prioritaire.
  levelId     String?
  trackId     String?
  classRoomId String?

  /// Applique automatiquement a toute nouvelle inscription concernee.
  isMandatory     Boolean  @default(true)
  autoAssign      Boolean  @default(true)
  /// Modele d'echeancier (JSON) :
  /// [{"label":"1ere tranche","percent":4000,"dueDate":"2025-10-15"}]
  /// percent est en CENTIEMES de pourcent (4000 = 40,00 %).
  installmentPlan String   @default("[]")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level?       @relation(fields: [levelId], references: [id], onDelete: SetNull)
  track        Track?       @relation(fields: [trackId], references: [id], onDelete: SetNull)
  classRoom    ClassRoom?   @relation(fields: [classRoomId], references: [id], onDelete: SetNull)

  assignments FeeAssignment[]

  @@unique([schoolId, academicYearId, code])
  @@index([schoolId, academicYearId, isActive])
}

/// Frais effectivement du par UN eleve. Ligne de "facturation" scolaire.
model FeeAssignment {
  id               String   @id @default(cuid())
  schoolId         String
  studentId        String
  academicYearId   String
  feeItemId        String?
  label            String
  category         String   @default("SCOLARITE")
  /// Montant brut avant remises.
  grossAmountMinor Int
  currency         String   @default("XOF")
  /// ACTIVE | CANCELLED
  status           String   @default("ACTIVE")
  note             String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeItem      FeeItem?     @relation(fields: [feeItemId], references: [id], onDelete: SetNull)

  discounts    Discount[]
  installments Installment[]
  allocations  PaymentAllocation[]

  @@index([schoolId, studentId, academicYearId])
  @@index([schoolId, academicYearId, status])
}

/// Bourse, exoneration, remise fratrie, remise commerciale.
model Discount {
  id              String   @id @default(cuid())
  feeAssignmentId String
  /// BOURSE | EXONERATION | FRATRIE | COMMERCIALE | AUTRE
  kind            String   @default("COMMERCIALE")
  label           String
  /// Soit un montant fixe, soit un pourcentage en centiemes de % (1000 = 10,00 %).
  amountMinor     Int?
  percentCenti    Int?
  grantedById     String?
  reason          String   @default("")
  createdAt       DateTime @default(now())

  feeAssignment FeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)

  @@index([feeAssignmentId])
}

/// Echeance d'un frais (paiement fractionne).
model Installment {
  id              String   @id @default(cuid())
  schoolId        String
  feeAssignmentId String
  label           String
  amountMinor     Int
  dueDate         DateTime
  sortOrder       Int      @default(0)
  /// Penalite de retard eventuelle, calculee et figee lors de l'application.
  penaltyMinor    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeAssignment FeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)

  allocations PaymentAllocation[]

  @@index([schoolId, dueDate])
  @@index([feeAssignmentId, sortOrder])
}

// ===========================================================================
// 8. PAIEMENTS, JUSTIFICATIFS, RECUS, REMBOURSEMENTS
// ===========================================================================

model Payment {
  id          String @id @default(cuid())
  schoolId    String
  studentId   String
  /// Numero sequentiel lisible, unique par ecole.
  reference   String
  amountMinor Int
  currency    String @default("XOF")
  /// ESPECES | VIREMENT | CHEQUE | MOBILE_MONEY | EN_LIGNE
  method      String @default("ESPECES")
  /// VALIDATED | CANCELLED.
  /// Un Payment n'existe que s'il est REELLEMENT encaisse et valide. Les
  /// justificatifs televerses par les parents vivent dans PaymentProof et ne
  /// deviennent un Payment qu'apres acceptation par le comptable.
  status      String @default("VALIDATED")

  paidAt             DateTime  @default(now())
  externalReference  String    @default("") // ref. Mobile Money / cheque / virement
  financialAccountId String?
  cashierId          String?
  proofId            String?   @unique
  note               String    @default("")
  /// Cle d'idempotence : empeche le double encaissement sur re-soumission.
  idempotencyKey     String?
  cancelledAt        DateTime?
  cancelReason       String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cashier          User?             @relation("PaymentCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  proof            PaymentProof?     @relation(fields: [proofId], references: [id], onDelete: SetNull)

  allocations PaymentAllocation[]
  receipt     Receipt?
  refunds     Refund[]

  @@unique([schoolId, reference])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, paidAt])
  @@index([studentId, status])
}

/// Imputation d'un paiement sur un frais / une echeance.
model PaymentAllocation {
  id              String  @id @default(cuid())
  paymentId       String
  feeAssignmentId String
  installmentId   String?
  amountMinor     Int

  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeAssignment FeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)
  installment   Installment?  @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([feeAssignmentId])
  @@index([paymentId])
}

/// Justificatif televerse par un parent. Tant qu'il n'est pas ACCEPTE il
/// n'augmente AUCUN encaissement valide (cahier des charges 9).
model PaymentProof {
  id                  String    @id @default(cuid())
  schoolId            String
  studentId           String
  declaredAmountMinor Int
  currency            String    @default("XOF")
  declaredMethod      String    @default("MOBILE_MONEY")
  declaredReference   String    @default("")
  declaredPaidAt      DateTime?
  documentId          String?
  /// EN_ATTENTE | ACCEPTE | REJETE
  status              String    @default("EN_ATTENTE")

  submittedById   String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String    @default("")
  /// Donnees extraites par OCR (JSON). Indicatif : ne valide JAMAIS seul.
  ocrExtract      String    @default("{}")
  ocrStatus       String    @default("NONE") // NONE | PENDING | DONE | FAILED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  submittedBy User?     @relation("ProofSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User?     @relation("ProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  payment Payment?

  @@index([schoolId, status])
  @@index([studentId, status])
}

model Receipt {
  id         String   @id @default(cuid())
  schoolId   String
  paymentId  String   @unique
  /// Numero de recu unique par ecole.
  number     String
  issuedAt   DateTime @default(now())
  documentId String?
  /// Contenu fige du recu (JSON) pour reimpression a l'identique.
  snapshot   String   @default("{}")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, number])
}

model Refund {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String
  paymentId    String?
  amountMinor  Int
  currency     String    @default("XOF")
  reason       String
  method       String    @default("ESPECES")
  status       String    @default("PENDING") // PENDING | APPROVED | PAID | REJECTED
  approvedById String?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
}

// ===========================================================================
// 9. DEPENSES, TRESORERIE, COMPTABILITE
// ===========================================================================

model ExpenseCategory {
  id                 String  @id @default(cuid())
  schoolId           String
  code               String
  name               String
  /// Compte de charge par defaut du plan comptable.
  defaultAccountCode String  @default("")
  isActive           Boolean @default(true)

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([schoolId, code])
}

model Supplier {
  id          String   @id @default(cuid())
  schoolId    String
  code        String
  name        String
  taxId       String   @default("")
  email       String   @default("")
  phone       String   @default("")
  address     String   @default("")
  bankDetails String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([schoolId, code])
}

model Expense {
  id                 String  @id @default(cuid())
  schoolId           String
  categoryId         String
  supplierId         String?
  financialAccountId String?
  reference          String
  label              String
  description        String  @default("")
  amountMinor        Int
  currency           String  @default("XOF")
  /// DRAFT | REQUESTED | APPROVED | REJECTED | PAID | CANCELLED
  status             String  @default("DRAFT")

  invoiceNumber   String    @default("")
  invoiceDate     DateTime?
  dueDate         DateTime?
  paidAt          DateTime?
  paymentMethod   String    @default("ESPECES")
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category         ExpenseCategory   @relation(fields: [categoryId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  approvedBy       User?             @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  attachments Document[]

  @@unique([schoolId, reference])
  @@index([schoolId, status])
  @@index([schoolId, paidAt])
}

/// Caisse ou compte bancaire de l'etablissement.
model FinancialAccount {
  id                  String   @id @default(cuid())
  schoolId            String
  code                String
  name                String
  kind                String   @default("CAISSE") // CAISSE | BANQUE | MOBILE_MONEY
  accountNumber       String   @default("")
  bankName            String   @default("")
  currency            String   @default("XOF")
  openingBalanceMinor Int      @default(0)
  /// Compte du plan comptable associe (ex. 571 Caisse, 521 Banque).
  ledgerAccountCode   String   @default("")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments        Payment[]
  expenses        Expense[]
  reconciliations BankReconciliation[]

  @@unique([schoolId, code])
}

model BankReconciliation {
  id                    String   @id @default(cuid())
  financialAccountId    String
  periodStart           DateTime
  periodEnd             DateTime
  statementBalanceMinor Int
  bookBalanceMinor      Int
  differenceMinor       Int
  status                String   @default("OPEN") // OPEN | CLOSED
  notes                 String   @default("")
  createdAt             DateTime @default(now())

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([financialAccountId, periodEnd])
}

/// Plan comptable configurable (compatible SYSCOHADA).
model LedgerAccount {
  id           String  @id @default(cuid())
  schoolId     String
  code         String
  name         String
  /// ACTIF | PASSIF | CAPITAUX | PRODUIT | CHARGE
  type         String
  /// Classe SYSCOHADA 1..8
  accountClass Int     @default(0)
  parentCode   String  @default("")
  isActive     Boolean @default(true)

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lines  JournalLine[]

  @@unique([schoolId, code])
  @@index([schoolId, type])
}

model AccountingPeriod {
  id        String    @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    String    @default("OPEN") // OPEN | CLOSED
  closedAt  DateTime?

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entries JournalEntry[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
}

model JournalEntry {
  id           String    @id @default(cuid())
  schoolId     String
  periodId     String?
  /// VE (ventes) | AC (achats) | BQ (banque) | CA (caisse) | OD (operations diverses)
  journalCode  String    @default("OD")
  reference    String
  date         DateTime
  label        String
  /// DRAFT | POSTED | REVERSED
  /// Une ecriture POSTED n'est JAMAIS supprimee : on la contrepasse.
  status       String    @default("DRAFT")
  /// Lien vers l'ecriture d'annulation / l'ecriture d'origine.
  reversalOfId String?
  sourceType   String    @default("MANUAL") // MANUAL | PAYMENT | EXPENSE | FEE | REFUND
  sourceId     String    @default("")
  postedById   String?
  postedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  period   AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  postedBy User?             @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: SetNull)

  reversalOf JournalEntry?  @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry[] @relation("EntryReversal")

  lines JournalLine[]

  @@unique([schoolId, reference])
  @@index([schoolId, date])
  @@index([schoolId, status])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id          String @id @default(cuid())
  entryId     String
  accountId   String
  label       String @default("")
  debitMinor  Int    @default(0)
  creditMinor Int    @default(0)
  sortOrder   Int    @default(0)

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
}

model Budget {
  id             String @id @default(cuid())
  schoolId       String
  academicYearId String
  label          String
  category       String
  /// Montant budgete pour la periode.
  plannedMinor   Int
  currency       String @default("XOF")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicYearId, label])
}

// ===========================================================================
// 10. DOCUMENTS, COMMUNICATION, AUDIT, IMPORTS
// ===========================================================================

/// Fichier stocke dans un espace PRIVE. Jamais servi directement :
/// l'acces passe par /api/files/[id] qui verifie tenant + permissions.
model Document {
  id         String  @id @default(cuid())
  schoolId   String?
  /// Cle de stockage (chemin relatif dans le driver, hors dossier public).
  storageKey String  @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  checksum   String  @default("")
  /// LOGO | PHOTO | JUSTIFICATIF | RECU | BULLETIN | DEVOIR | REMISE |
  /// PIECE_DEPENSE | CERTIFICAT | CARTE | AUTRE
  kind       String  @default("AUTRE")
  /// Visibilite minimale requise (controle serveur complementaire).
  visibility String  @default("STAFF") // STAFF | GUARDIAN | STUDENT | PUBLIC_SCHOOL

  uploadedById String?
  studentId    String?
  staffId      String?
  expenseId    String?
  assignmentId String?
  submissionId String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  school     School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff      Staff?      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  paymentProofs PaymentProof[]

  @@index([schoolId, kind])
  @@index([studentId])
}

model Announcement {
  id          String    @id @default(cuid())
  schoolId    String
  classRoomId String?
  authorId    String?
  title       String
  body        String
  /// Audiences ciblees (JSON array de codes de role) ex. ["GUARDIAN","STUDENT"]
  audiences   String    @default("[]")
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRoom ClassRoom? @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  author    User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([schoolId, publishedAt])
}

model MessageThread {
  id        String   @id @default(cuid())
  schoolId  String
  subject   String
  studentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  participants ThreadParticipant[]
  messages     Message[]

  @@index([schoolId, updatedAt])
}

model ThreadParticipant {
  threadId   String
  userId     String
  lastReadAt DateTime?

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

model Notification {
  id             String    @id @default(cuid())
  schoolId       String?
  userId         String
  studentId      String?
  /// NOTES_PUBLIEES | ABSENCE | PAIEMENT_VALIDE | JUSTIFICATIF_REJETE |
  /// ECHEANCE_PROCHE | ANNONCE | DEVOIR | AUTRE
  kind           String    @default("AUTRE")
  title          String
  body           String    @default("")
  link           String    @default("")
  /// Canal de diffusion reellement utilise.
  channel        String    @default("IN_APP") // IN_APP | EMAIL | SMS | WHATSAPP
  /// PENDING | SENT | FAILED (pour les canaux externes)
  deliveryStatus String    @default("SENT")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  school  School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([schoolId, createdAt])
}

model DocumentRequest {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  requestedById String?
  /// CERTIFICAT_SCOLARITE | BULLETIN | RELEVE | ATTESTATION | CARTE | AUTRE
  kind          String   @default("CERTIFICAT_SCOLARITE")
  note          String   @default("")
  status        String   @default("PENDING") // PENDING | READY | DELIVERED | REJECTED
  documentId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation("DocRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
}

model AppointmentRequest {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String?
  staffId       String?
  requestedById String?
  subject       String
  message       String    @default("")
  preferredAt   DateTime?
  confirmedAt   DateTime?
  status        String    @default("PENDING") // PENDING | CONFIRMED | DECLINED | DONE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  requestedBy User?    @relation("AppointmentRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
}

/// Journal d'audit : toute operation sensible y est tracee.
model AuditEvent {
  id         String   @id @default(cuid())
  schoolId   String?
  userId     String?
  action     String // ex. "payment.create", "auth.login.failed"
  entityType String   @default("")
  entityId   String   @default("")
  /// Donnees NON sensibles uniquement. Jamais de mot de passe ni de cle API.
  metadata   String   @default("{}")
  ipAddress  String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

/// Import CSV / Excel : apercu, validation, rapport d'erreurs, doublons.
model ImportBatch {
  id       String  @id @default(cuid())
  schoolId String
  userId   String?
  /// STUDENTS | STAFF | GRADES | PAYMENTS
  kind     String
  fileName String

  totalRows     Int      @default(0)
  validRows     Int      @default(0)
  errorRows     Int      @default(0)
  duplicateRows Int      @default(0)
  importedRows  Int      @default(0)
  /// PREVIEW | COMMITTED | CANCELLED
  status        String   @default("PREVIEW")
  /// Rapport detaille (JSON) : lignes, erreurs par colonne, doublons detectes.
  report        String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, kind, status])
}

/// Limitation des tentatives (connexion, upload, actions sensibles).
model RateLimitBucket {
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
}

/// Appreciation portee par l'enseignant sur une matiere, pour un eleve et une
/// periode. Distincte de l'appreciation generale du bulletin, qui releve du
/// conseil de classe. Elle est FIGEE dans le bulletin a la generation : une
/// modification ulterieure ne reecrit pas un bulletin deja remis.
model SubjectAppreciation {
  id              String  @id @default(cuid())
  schoolId        String
  studentId       String
  gradingPeriodId String
  subjectId       String
  /// Auteur de l'appreciation, conserve pour la tracabilite.
  teacherId       String?
  text            String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradingPeriod GradingPeriod @relation(fields: [gradingPeriodId], references: [id], onDelete: Cascade)
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher       Staff?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, gradingPeriodId, subjectId])
  @@index([schoolId, gradingPeriodId, subjectId])
}

/// Ouvrage ou ressource du fonds documentaire (module optionnel BIBLIOTHEQUE).
model LibraryItem {
  id          String  @id @default(cuid())
  schoolId    String
  /// Cote ou code interne, unique dans l'etablissement.
  reference   String
  title       String
  author      String  @default("")
  publisher   String  @default("")
  isbn        String  @default("")
  /// LIVRE | MANUEL | REVUE | MULTIMEDIA | AUTRE
  kind        String  @default("LIVRE")
  category    String  @default("")
  /// Nombre d'exemplaires detenus. Les prets en cours s'en deduisent.
  totalCopies Int     @default(1)
  shelf       String  @default("")
  notes       String  @default("")
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  loans  LibraryLoan[]

  @@unique([schoolId, reference])
  @@index([schoolId, isActive])
}

/// Pret d'un exemplaire a un eleve ou a un membre du personnel.
model LibraryLoan {
  id        String  @id @default(cuid())
  schoolId  String
  itemId    String
  /// Emprunteur : un eleve OU un membre du personnel, jamais les deux.
  studentId String?
  staffId   String?

  loanedAt   DateTime  @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  /// EN_COURS | RENDU | PERDU
  status     String    @default("EN_COURS")
  condition  String    @default("")
  notes      String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item    LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff   Staff?      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([itemId, status])
  @@index([studentId, status])
}
