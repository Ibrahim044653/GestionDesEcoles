# ---------------------------------------------------------------------------
# Gestion Ecole - exemple de configuration. Copier vers .env et completer.
# AUCUN SECRET REEL NE DOIT ETRE COMMIT DANS CE FICHIER.
# ---------------------------------------------------------------------------

# Base de donnees -----------------------------------------------------------
# Par defaut SQLite (fonctionne sans serveur, ideal pour le developpement).
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) : voir prisma/schema.prisma, bloc `datasource db`.
# Prisma interdit env() sur `provider` : passer "sqlite" -> "postgresql" a la main.
# DATABASE_URL="postgresql://user:motdepasse@localhost:5432/gestion_ecole?schema=public"

# Sessions ------------------------------------------------------------------
# Generer une valeur aleatoire de 32+ octets :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="CHANGER_CETTE_VALEUR_EN_PRODUCTION_32_OCTETS_MINIMUM"
SESSION_TTL_HOURS="12"

# Application ---------------------------------------------------------------
APP_URL="http://localhost:3000"
APP_LOCALE="fr-CI"
NODE_ENV="development"

# Stockage prive des fichiers (justificatifs, documents, photos) -------------
# Chemin hors du dossier public : les fichiers sont servis via /api/files/:id
# apres verification du tenant et des permissions.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
STORAGE_MAX_UPLOAD_MB="8"

# Donnees de demonstration --------------------------------------------------
# Mot de passe applique a tous les comptes de demonstration du seed.
SEED_DEMO_PASSWORD="Demo@2026"
# Bloque l'execution du seed si NODE_ENV=production et que cette valeur != "true"
ALLOW_SEED_IN_PRODUCTION="false"

# ---------------------------------------------------------------------------
# INTEGRATIONS EXTERNES - NON ACTIVES.
# Aucune de ces integrations n'est implementee reellement : les modules
# correspondants exposent une interface et un mode TEST explicite.
# Ne pas declarer une integration active tant qu'elle n'est pas configuree ET testee.
# ---------------------------------------------------------------------------

# Paiement en ligne (Mobile Money / carte) : interface prete, aucun prestataire branche
PAYMENT_PROVIDER="none"          # none | wave | orange_money | mtn_momo | stripe
PAYMENT_PROVIDER_MODE="test"     # test | live
PAYMENT_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_WEBHOOK_SECRET=""

# E-mail sortant : par defaut les messages sont ecrits en base (boite "console")
MAIL_DRIVER="log"                # log | smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@example.test"

# SMS / WhatsApp : interface prete, aucun prestataire branche
SMS_DRIVER="none"                # none | twilio | orange_sms
SMS_API_KEY=""
WHATSAPP_DRIVER="none"

# OCR / IA : interface prete, desactivee par defaut.
# Un OCR ne valide JAMAIS seul un paiement, une IA ne publie JAMAIS de notes.
OCR_DRIVER="none"                # none | tesseract | external
AI_DRIVER="none"                 # none | anthropic | openai
AI_API_KEY=""
AI_SEND_PERSONAL_DATA="false"    # consentement requis avant activation
